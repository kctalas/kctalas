{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kctalas",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
